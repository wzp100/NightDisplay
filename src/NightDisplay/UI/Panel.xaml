<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      TextElement.FontFamily="{StaticResource UiFont}" TextElement.FontSize="14"
      TextElement.Foreground="{DynamicResource TextPrimary}" TextOptions.TextFormattingMode="Display">
    <!-- Layout only. Behavior is wired by name in PanelWindow.cs so the file loads without a XAML compiler. -->
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="232" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <DockPanel Margin="12,16,8,16">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
            <Image x:Name="Logo" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="NightDisplay" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="让屏幕休息，让工作继续。" Style="{StaticResource Caption}" />
            </StackPanel>
        </StackPanel>
        <TextBlock x:Name="Footer" DockPanel.Dock="Bottom" Margin="12,0,8,0" Style="{StaticResource Caption}"
                   Text="后台保护已开启 · 本地运行&#10;NightDisplay 1.3" />
        <StackPanel>
            <RadioButton x:Name="NavHome" Style="{StaticResource NavItem}" Tag="&#xE7F4;" Content="屏幕控制" IsChecked="True" GroupName="Nav" />
            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" Tag="&#xE713;" Content="设置与保护" GroupName="Nav" />
        </StackPanel>
    </DockPanel>

    <DockPanel Grid.Column="1">
        <!-- InfoBar: errors and notices from actions, shown above either page. -->
        <Border x:Name="InfoBar" DockPanel.Dock="Top" Margin="28,20,36,0" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource CardStroke}" Padding="14,10,6,10" Visibility="Collapsed">
            <DockPanel>
                <TextBlock x:Name="InfoGlyph" Style="{StaticResource Glyph}" FontSize="16" VerticalAlignment="Top" Margin="0,2,12,0" />
                <Button x:Name="InfoClose" DockPanel.Dock="Right" Style="{StaticResource SubtleButton}" Content="&#xE711;"
                        FontSize="12" VerticalAlignment="Top" ToolTip="关闭" />
                <StackPanel>
                    <TextBlock x:Name="InfoTitle" Style="{StaticResource BodyStrong}" />
                    <TextBlock x:Name="InfoText" Style="{StaticResource Body}" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="28,20,36,28" MaxWidth="760">
                    <TextBlock Text="屏幕控制" Style="{StaticResource Title}" Margin="0,0,0,20" />

                    <Border Style="{StaticResource Card}" Padding="24,22">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="StateBadge" Width="56" Height="56" CornerRadius="28" Margin="0,0,18,0"
                                        Background="{DynamicResource SubtleFillSelected}" VerticalAlignment="Top">
                                    <TextBlock x:Name="StateGlyph" Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="24" HorizontalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="当前屏幕输出" Style="{StaticResource Caption}" />
                                    <TextBlock x:Name="StateText" Text="正在检测屏幕…" Style="{StaticResource Subtitle}" Margin="0,2,0,4" />
                                    <TextBlock x:Name="DetailText" Text="等待显示器响应" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DockPanel>
                            <UniformGrid Rows="1" Columns="3" Margin="0,22,0,0">
                                <Button x:Name="VirtualButton" Style="{StaticResource AccentButton}" Content="进入虚拟屏" MinHeight="40" Margin="0,0,6,0" />
                                <Button x:Name="PhysicalButton" Content="恢复实体屏" MinHeight="40" Margin="3,0" />
                                <Button x:Name="TestButton" Content="测试 8 秒" MinHeight="40" Margin="6,0,0,0" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="手机遥控" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8EA;" Margin="0,0,16,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="PhoneCopyButton" Content="复制手机链接" Margin="0,0,8,0" />
                                <Button x:Name="PhoneOpenButton" Content="打开控制网页" />
                            </StackPanel>
                            <TextBlock x:Name="PhoneText" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>

                    <TextBlock Margin="2,16,0,0" Style="{StaticResource Caption}"
                               Text="首次使用可先测试 8 秒。关闭此窗口会释放界面，快捷键与恢复保护继续运行。" />
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="Collapsed">
                <StackPanel Margin="28,20,36,28" MaxWidth="760">
                    <TextBlock Text="设置与保护" Style="{StaticResource Title}" Margin="0,0,0,4" />

                    <TextBlock Text="虚拟显示器" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7F4;" Margin="0,0,16,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <ComboBox x:Name="VirtualSelect" Width="240" />
                                <Button x:Name="RefreshButton" Style="{StaticResource SubtleButton}" Content="&#xE72C;" Margin="4,0,0,0" ToolTip="刷新" />
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="输出设备" Style="{StaticResource Body}" />
                                <TextBlock Text="进入虚拟模式时使用的显示器" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE896;" Margin="0,0,16,0" />
                            <Button x:Name="InstallButton" DockPanel.Dock="Right" Content="安装虚拟屏" VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="虚拟屏驱动" Style="{StaticResource Body}" />
                                <TextBlock Text="未检测到虚拟显示器时安装，需要管理员权限" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="全局快捷键" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE8AB;" Margin="0,0,16,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Alt +" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="ToggleSelect" Width="96" />
                            </StackPanel>
                            <TextBlock Text="切换虚拟屏与实体屏" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE777;" Margin="0,0,16,0" />
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Ctrl + Alt +" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="RestoreSelect" Width="96" />
                            </StackPanel>
                            <TextBlock Text="恢复实体屏" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" MinHeight="56">
                        <DockPanel>
                            <Button x:Name="SaveHotkeysButton" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="保存快捷键" VerticalAlignment="Center" />
                            <TextBlock x:Name="HotkeyText" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="36,0,16,0" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="常规" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE7E8;" Margin="0,0,16,0" />
                            <CheckBox x:Name="StartupCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="登录时启动" Style="{StaticResource Body}" />
                                <TextBlock Text="启动时恢复实体屏" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE708;" Margin="0,0,16,0" />
                            <CheckBox x:Name="AwakeCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="虚拟模式保持运行" Style="{StaticResource Body}" />
                                <TextBlock Text="虚拟模式下保持电脑和虚拟桌面运行" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xE701;" Margin="0,0,16,0" />
                            <CheckBox x:Name="LanCheck" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" />
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="局域网手机控制" Style="{StaticResource Body}" />
                                <TextBlock Text="开启后才监听端口，需要 Windows 防火墙授权" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="恢复保护" Style="{StaticResource SectionHeader}" />
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Glyph}" Text="&#xEA18;" Margin="0,0,16,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Caption}"
                                       Text="切换前保存实体屏配置；虚拟输出仅临时生效。异常退出或界面无响应时，独立守护进程尝试恢复实体屏。" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Grid>
